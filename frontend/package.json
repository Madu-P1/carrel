{
  "name": "carrel-frontend",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:macos": "tsc --noEmit && CARREL_MACOS_BUNDLE=1 vite build && node ./scripts/build-macos.mjs",
    "launch:macos": "cd .. && ./script/build_and_run.sh",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint . --ext .ts,.tsx --max-warnings 0",
    "test": "NODE_OPTIONS=--max-old-space-size=4096 vitest run",
    "test:watch": "NODE_OPTIONS=--max-old-space-size=4096 vitest"
  },
  "dependencies": {
    "3d-force-graph": "^1.80.0",
    "@preact/signals": "^2.9.0",
    "pdfjs-dist": "^4.10.38",
    "preact": "^10.29.1",
    "preact-iso": "^2.12.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.5",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^22.19.18",
    "@types/three": "^0.184.1",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^25.0.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.2",
    "vitest": "^2.1.9"
  }
}
