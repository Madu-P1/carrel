{
  "name": "carrel-frontend",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:macos": "tsc --noEmit && CARREL_MACOS_BUNDLE=1 vite build && node ./scripts/build-macos.mjs",
    "launch:macos": "cd .. && ./script/build_and_run.sh",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint . --ext .ts,.tsx --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "3d-force-graph": "^1.80.0",
    "@preact/signals": "^2.9.0",
    "pdfjs-dist": "^4.8.0",
    "preact": "^10.24.0",
    "preact-iso": "^2.9.1",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.0",
    "@testing-library/preact": "^3.2.0",
    "@types/node": "^22.7.0",
    "@types/three": "^0.184.0",
    "@typescript-eslint/eslint-plugin": "^8.10.0",
    "@typescript-eslint/parser": "^8.10.0",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "jsdom": "^25.0.0",
    "openapi-typescript": "^7.4.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
