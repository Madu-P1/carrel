    <ellipse cx="84" cy="109" rx="7" ry="7" fill="#5b8dd9"/>
    <ellipse cx="116" cy="109" rx="7" ry="7" fill="#5b8dd9"/>
    <ellipse class="av-eye" cx="84" cy="110" rx="4.5" ry="4.5" fill="#1a1a2e"/>
