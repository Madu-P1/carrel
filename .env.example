ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_FAST=claude-haiku-4-5
ANTHROPIC_MODEL_BALANCED=claude-sonnet-4-6
ANTHROPIC_MODEL_DEEP=claude-opus-4-7
ANTHROPIC_SERVICE_TIER=auto
EMBED_ON_INGEST=true
RUN_VECTOR_BACKFILL=true

# AI provider selection. Picks which backend serves LLM calls.
# "auto" (default) prefers Claude when ANTHROPIC_API_KEY is set, otherwise
# falls through to Ollama. "claude"/"ollama"/"afm" force a provider. "off"
# disables AI entirely (tutor returns visible snippet fallback).
EINSTEIN_AI_PROVIDER=auto

# Ollama provider. Two modes:
#   Local:  OLLAMA_BASE_URL=http://127.0.0.1:11434  (no API key needed)
#   Cloud:  OLLAMA_BASE_URL=https://ollama.com  +  OLLAMA_API_KEY=<key>
# Ollama Cloud has a free tier (no paid account); get a key at
# https://ollama.com/settings/keys. Cloud mode sends sources off-device.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_API_KEY=
OLLAMA_MODEL_FAST=llama3.2:3b
OLLAMA_MODEL_BALANCED=llama3.1:8b
OLLAMA_MODEL_DEEP=llama3.1:70b
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_KEEP_ALIVE=5m

# Optional runtime path overrides
# EINSTEIN_BASE_DIR=/absolute/path/to/Codex
# EINSTEIN_DATA_DIR=/absolute/path/to/Codex/data
# EINSTEIN_UPLOAD_DIR=/absolute/path/to/Codex/data/uploads
# EINSTEIN_DB_PATH=/absolute/path/to/Codex/data/einstein_tutor.db
# EINSTEIN_SCHEMA_PATH=/absolute/path/to/Codex/schema.sql
# EINSTEIN_LOG_DIR=/absolute/path/to/Codex/data/logs
# EINSTEIN_BENCHMARK_DIR=/absolute/path/to/Codex/data/benchmarks
