# pnpm-lock.yaml is the canonical lockfile (matches CI + packageManager
# pnpm@9.12.0 in package.json). bun.lock is gitignored so devs who use
# bun locally don't accidentally commit a divergent lockfile.
frontend/bun.lock
frontend/bun.lockb

factory-reset-audit-*/

# CI-only: fastembed caches the embedding model here (see
# .github/actions/warm-embedding-model); restored via actions/cache, never committed.
.fastembed-cache/

macos-app/.build/
macos-app/Resources/app.new.html
macos-app/Resources/app.new*.html
macos-app/Resources/assets.new/

# Untracked local cruft that sits in the working tree but is not part of Carrel:
# a separate ChatGPT app checkout, a stray root-level image, and Forge runtime
# state (per-run metrics + verdict JSON). None of these belong in the repo.
/chatgpt-app/
/man_solo_portrait_final.png
/.forge/

# Mythos report-only ledger (engine writes here; never committed)
.mythos/
