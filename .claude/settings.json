{
  "permissions": {
    "allow": [
      "Read(*)",
      "Edit(*)",
      "Write(*)",
      "Glob(*)",
      "Grep(*)",
      "Bash(uv:*)",
      "Bash(uv run:*)",
      "Bash(pytest:*)",
      "Bash(ruff:*)",
      "Bash(mypy:*)",
      "Bash(pyright:*)",
      "Bash(swift:*)",
      "Bash(swift build:*)",
      "Bash(swift test:*)",
      "Bash(pnpm:*)",
      "Bash(pnpm run:*)",
      "Bash(pnpm tsc:*)",
      "Bash(node:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git stash:*)",
      "Bash(git rev-parse:*)",
      "Bash(git show:*)",
      "Bash(make:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(fd:*)",
      "Bash(jq:*)",
      "Bash(chmod:+x*)",
      "Bash(mkdir:-p*)",
      "Bash(touch:*)",
      "Bash(curl:--head*)",
      "Bash(curl:-I*)"
    ],
    "deny": [
      "Bash(rm:-rf /*)",
      "Bash(rm:-rf $HOME*)",
      "Bash(rm:-rf ~*)",
      "Bash(sudo:*)",
      "Bash(su:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/obsidian-sync-nudge.py"
          }
        ]
      }
    ]
  }
}
